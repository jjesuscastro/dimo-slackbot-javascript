# Slack app credentials. Socket Mode requires both tokens.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Copy the Default destination values from HPL Toolbox settings if they differ.
PLEC_UPLOAD_URL=
PLEC_ORIGIN_URL=

# Optional: comma-separated channel IDs. Empty means respond in any channel
# where the bot is invited and can read messages.
ALLOWED_CHANNEL_IDS=
